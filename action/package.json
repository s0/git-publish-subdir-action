{
  "name": "git-publish-subdir-action",
  "scripts": {
    "build": "tsc && ncc build lib/src/run",
    "lint-prettier": "prettier -c src/**/* test/**/*.ts",
    "lint": "npm run lint-prettier",
    "lint:fix": "prettier -w src/**/* test/**/*.ts",
    "start": "node lib",
    "test-init": "jest --projects test/jest.config.js --runInBand --verbose",
    "test-run": "nyc ts-node --transpile-only src",
    "test": "./test/bin/run-tests.sh --colors"
  },
  "devDependencies": {
    "@types/git-url-parse": "^16.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.3",
    "@types/normalize-url": "^4.1.0",
    "@vercel/ncc": "^0.44.0",
    "dotenv": "^17.4.2",
    "git-url-parse": "^16.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@actions/io": "^2.0.0",
    "fast-glob": "^3.3.3",
    "isomorphic-git": "^1.38.5",
    "normalize-url": "^9.0.1"
  }
}
